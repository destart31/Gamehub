<Window x:Class="GameHub.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="GameHub - Central de Jogos" Height="780" Width="1150"
        MinHeight="600" MinWidth="850"
        WindowStartupLocation="CenterScreen"
        Background="#0B0C10"
        Icon="Assets\app.ico"
        KeyDown="Window_KeyDown">
    <WindowChrome.WindowChrome>
        <WindowChrome CaptionHeight="35" GlassFrameThickness="0" CornerRadius="0" UseAeroCaptionButtons="False"/>
    </WindowChrome.WindowChrome>

    <Window.Resources>
        <BooleanToVisibilityConverter x:Key="BoolToVis"/>
        <!-- Tile da tela Início -->
        <DataTemplate x:Key="HomeTileTemplate">
            <Border Width="150" Height="150" Margin="0,0,16,0" CornerRadius="10"
                    Background="#161824" BorderBrush="Transparent" BorderThickness="2"
                    Cursor="Hand" Tag="{Binding}" ContextMenuOpening="GameCard_ContextMenuOpening"
                    MouseLeftButtonDown="Card_MouseLeftButtonDown" MouseEnter="HomeTile_MouseEnter">
                <!-- O recorte fica no conteúdo, recuado pela borda (150 - 2x2 = 146; raio 10 - 2 = 8) -->
                <Grid>
                    <Grid.Clip>
                        <RectangleGeometry Rect="0,0,146,146" RadiusX="8" RadiusY="8"/>
                    </Grid.Clip>
                    <Image Source="{Binding CoverImage}" Stretch="UniformToFill"/>

                    <!-- Etiqueta: só nos jogos não instalados -->
                    <Border HorizontalAlignment="Left" VerticalAlignment="Bottom" Margin="7"
                            Padding="7,2" CornerRadius="10" Background="#E00C0E14">
                        <Border.Style>
                            <Style TargetType="Border">
                                <Setter Property="Visibility" Value="Collapsed"/>
                                <Style.Triggers>
                                    <DataTrigger Binding="{Binding IsInstalled}" Value="False">
                                        <Setter Property="Visibility" Value="Visible"/>
                                    </DataTrigger>
                                </Style.Triggers>
                            </Style>
                        </Border.Style>
                        <StackPanel Orientation="Horizontal">
                            <TextBlock Text="&#xE896;" FontFamily="Segoe Fluent Icons, Segoe MDL2 Assets"
                                       FontSize="9" Foreground="#10B981" VerticalAlignment="Center" Margin="0,0,5,0"/>
                            <TextBlock Text="Não instalado" FontSize="9" FontWeight="SemiBold"
                                       Foreground="#E5E7EB" VerticalAlignment="Center"/>
                        </StackPanel>
                    </Border>
                </Grid>
            </Border>
        </DataTemplate>
        <Visibility x:Key="CardPlayVis">Visible</Visibility>
        <Visibility x:Key="CardEditVis">Visible</Visibility>
                <!-- Estilo do TextBox de Pesquisa -->
        <Style x:Key="SearchTextBoxStyle" TargetType="TextBox">
            <Setter Property="Background" Value="#161824"/>
            <Setter Property="Foreground" Value="#F3F4F6"/>
            <Setter Property="BorderBrush" Value="#2A2D3F"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="Padding" Value="14,8"/>
            <Setter Property="FontSize" Value="14"/>
            <Setter Property="VerticalContentAlignment" Value="Center"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="TextBox">
                        <Border Background="{TemplateBinding Background}"
                                BorderBrush="{TemplateBinding BorderBrush}"
                                BorderThickness="{TemplateBinding BorderThickness}"
                                CornerRadius="10">
                            <Grid>
                                <ScrollViewer x:Name="PART_ContentHost"/>
                                <TextBlock Text="🔍  Buscar jogo por nome..." Foreground="#6B7280" FontSize="14" Margin="14,0,0,0"
                                           VerticalAlignment="Center" IsHitTestVisible="False">
                                    <TextBlock.Style>
                                        <Style TargetType="TextBlock">
                                            <Setter Property="Visibility" Value="Collapsed"/>
                                            <Style.Triggers>
                                                <DataTrigger Binding="{Binding Text, RelativeSource={RelativeSource AncestorType=TextBox}}" Value="">
                                                    <Setter Property="Visibility" Value="Visible"/>
                                                </DataTrigger>
                                            </Style.Triggers>
                                        </Style>
                                    </TextBlock.Style>
                                </TextBlock>
                            </Grid>
                        </Border>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
            <Style x:Key="TopIconStyle" TargetType="Button">
            <Setter Property="Width" Value="46"/>
            <Setter Property="Height" Value="46"/>
            <Setter Property="Margin" Value="7,0"/>
            <Setter Property="Foreground" Value="#E5E7EB"/>
            <Setter Property="Background" Value="Transparent"/>
            <Setter Property="BorderBrush" Value="Transparent"/>
            <Setter Property="BorderThickness" Value="2"/>
            <Setter Property="FontFamily" Value="Segoe Fluent Icons, Segoe MDL2 Assets"/>
            <Setter Property="FontSize" Value="19"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Focusable" Value="False"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="Bd" CornerRadius="23" Background="{TemplateBinding Background}"
                                BorderBrush="{TemplateBinding BorderBrush}" BorderThickness="{TemplateBinding BorderThickness}">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Bd" Property="Background" Value="#26FFFFFF"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
        <Style x:Key="TopChipStyle" TargetType="Button">
            <Setter Property="Padding" Value="18,8"/>
            <Setter Property="Margin" Value="0,0,6,0"/>
            <Setter Property="FontSize" Value="14"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="Foreground" Value="#D1D5DB"/>
            <Setter Property="Background" Value="Transparent"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Focusable" Value="False"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="Bd" CornerRadius="20" Background="{TemplateBinding Background}"
                                Padding="{TemplateBinding Padding}">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Bd" Property="Opacity" Value="0.8"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- ═══════════════════════════════════════════════════════════
             Card: JOGO INSTALADO
             O Border pai tem ClipToBounds=True + CornerRadius=12.
             O filho NÃO repete CornerRadius (evita o bug das bordas).
        ════════════════════════════════════════════════════════════ -->
        <DataTemplate x:Key="InstalledGameCardTemplate">
            <Border Width="175" Height="255" Margin="0,0,14,14"
                    CornerRadius="12" ClipToBounds="True"
                    Background="#161824" BorderBrush="#10B981" BorderThickness="1.5"
                    Cursor="Hand" MouseLeftButtonDown="Card_MouseLeftButtonDown" MouseEnter="Card_MouseEnter" ContextMenuOpening="GameCard_ContextMenuOpening" Tag="{Binding}"
                    RenderTransformOrigin="0.5,0.5">
                <!-- ClipToBounds="True" só clipa ao RETÂNGULO do Border, ignorando o CornerRadius -
                     por isso a capa (Image) vazava quadrada nos cantos de cima. Este Clip explícito
                     usa o mesmo raio do CornerRadius acima, então agora clipa certinho arredondado. -->
                <!-- Clip recuado pela espessura da borda (1.5px) e com raio reduzido na mesma
                     medida - assim a curva do clip cai exatamente sob a curva da borda visível,
                     sem sobra nem fresta nos cantos. -->
                <Border.Clip>
                    <RectangleGeometry Rect="1.5,1.5,172,252" RadiusX="10.5" RadiusY="10.5"/>
                </Border.Clip>
                <Border.RenderTransform>
                    <ScaleTransform x:Name="InstalledCardScale" ScaleX="1.0" ScaleY="1.0"/>
                </Border.RenderTransform>

                <Border.Style>
                    <Style TargetType="Border">
                        <Style.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter Property="Background" Value="#1F2233"/>
                                <Setter Property="BorderBrush" Value="#34D399"/>
                            </Trigger>
                        </Style.Triggers>
                    </Style>
                </Border.Style>

                <Border.Triggers>
                    <EventTrigger RoutedEvent="Border.MouseEnter">
                        <BeginStoryboard>
                            <Storyboard>
                                <DoubleAnimation Storyboard.TargetName="InstalledCardScale" Storyboard.TargetProperty="ScaleX" To="1.05" Duration="0:0:0.15"/>
                                <DoubleAnimation Storyboard.TargetName="InstalledCardScale" Storyboard.TargetProperty="ScaleY" To="1.05" Duration="0:0:0.15"/>
                            </Storyboard>
                        </BeginStoryboard>
                    </EventTrigger>
                    <EventTrigger RoutedEvent="Border.MouseLeave">
                        <BeginStoryboard>
                            <Storyboard>
                                <DoubleAnimation Storyboard.TargetName="InstalledCardScale" Storyboard.TargetProperty="ScaleX" To="1.0" Duration="0:0:0.15"/>
                                <DoubleAnimation Storyboard.TargetName="InstalledCardScale" Storyboard.TargetProperty="ScaleY" To="1.0" Duration="0:0:0.15"/>
                            </Storyboard>
                        </BeginStoryboard>
                    </EventTrigger>
                </Border.Triggers>

                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="*"/>
                        <RowDefinition Height="Auto"/>
                    </Grid.RowDefinitions>

                    <!-- Área da Capa &#x2014; sem CornerRadius aqui, o pai já clipa -->
                    <Grid Grid.Row="0">
                        <Rectangle>
                            <Rectangle.Fill>
                                <LinearGradientBrush StartPoint="0,0" EndPoint="0,1">
                                    <GradientStop Color="#1E293B" Offset="0.0"/>
                                    <GradientStop Color="#0F172A" Offset="1.0"/>
                                </LinearGradientBrush>
                            </Rectangle.Fill>
                        </Rectangle>
                        <Viewbox Margin="25">
                            <TextBlock Text="🎮" Opacity="0.3"/>
                        </Viewbox>
                        <Image Source="{Binding CoverImage}" Stretch="UniformToFill"/>

                        <!-- Badges -->
                        <DockPanel VerticalAlignment="Top" Margin="8">
                            <Border DockPanel.Dock="Left" Background="#065F46" CornerRadius="8" Padding="6,3">
                                <TextBlock Text="🎮 INSTALADO" FontSize="9" FontWeight="Bold" Foreground="#A7F3D0"/>
                            </Border>
                            <TextBlock DockPanel.Dock="Left" Text="&#x2605;" FontSize="15" Foreground="#FBBF24"
                                       Margin="5,0,0,0" VerticalAlignment="Center" IsHitTestVisible="False"
                                       Visibility="{Binding IsFavorite, Converter={StaticResource BoolToVis}}">
                                <TextBlock.Effect>
                                    <DropShadowEffect Color="Black" BlurRadius="4" ShadowDepth="0" Opacity="0.9"/>
                                </TextBlock.Effect>
                            </TextBlock>
                            <Border DockPanel.Dock="Right" Background="#0F172A" CornerRadius="8" Padding="6,3" HorizontalAlignment="Right">
                                <Border.Style>
                                    <Style TargetType="Border">
                                        <Setter Property="Visibility" Value="Visible"/>
                                        <Style.Triggers>
                                            <DataTrigger Binding="{Binding EmulatorSystem}" Value="{x:Null}">
                                                <Setter Property="Visibility" Value="Collapsed"/>
                                            </DataTrigger>
                                        </Style.Triggers>
                                    </Style>
                                </Border.Style>
                                <TextBlock Text="{Binding EmulatorSystem}" FontSize="9" FontWeight="Bold" Foreground="#7DD3FC"/>
                            </Border>
                            <ItemsControl DockPanel.Dock="Right" ItemsSource="{Binding PlatformBadges}" HorizontalAlignment="Right">
                                <ItemsControl.ItemsPanel>
                                    <ItemsPanelTemplate>
                                        <StackPanel Orientation="Horizontal"/>
                                    </ItemsPanelTemplate>
                                </ItemsControl.ItemsPanel>
                                <ItemsControl.ItemTemplate>
                                    <DataTemplate>
                                        <Grid Width="20" Height="20" Margin="2,0,0,0">
                                            <Ellipse>
                                                <Ellipse.Fill>
                                                    <RadialGradientBrush>
                                                        <GradientStop Color="#00000000" Offset="0.5"/>
                                                        <GradientStop Color="#CC000000" Offset="1.0"/>
                                                    </RadialGradientBrush>
                                                </Ellipse.Fill>
                                            </Ellipse>
                                            <Image Source="{Binding IconPath}" Stretch="Uniform"
                                                   Margin="1" RenderOptions.BitmapScalingMode="HighQuality"/>
                                        </Grid>
                                    </DataTemplate>
                                </ItemsControl.ItemTemplate>
                            </ItemsControl>
                        </DockPanel>
                    </Grid>

                    <!-- Rodapé -->
                    <Border Grid.Row="1" Background="#12141F" Padding="10">
                        <StackPanel>
                            <TextBlock Text="{Binding Name}" FontSize="13" FontWeight="Bold" Foreground="#F3F4F6"
                                       TextTrimming="CharacterEllipsis" MaxHeight="36" TextWrapping="Wrap" Margin="0,0,0,8"/>
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="Auto"/>
                                </Grid.ColumnDefinitions>
                                <Button Grid.Column="0" Content="&#x25B6;  Jogar" Click="PlayButton_Click" Tag="{Binding}"
                                        Visibility="{DynamicResource CardPlayVis}"
                                        Background="#10B981" Foreground="White" FontWeight="Bold" FontSize="12"
                                        Padding="0,6" Cursor="Hand" HorizontalAlignment="Stretch" BorderThickness="0">
                                    <Button.Resources>
                                        <Style TargetType="Border">
                                            <Setter Property="CornerRadius" Value="6"/>
                                        </Style>
                                    </Button.Resources>
                                </Button>
                                <!-- Apagar ROM - só aparece em jogo de emulador, nunca em jogo de loja -->
                                <Button Grid.Column="1" Content="&#x1F5D1;&#xFE0F;" Click="DeleteRomButton_Click" Tag="{Binding}"
                                        Background="#3A1F26" Foreground="#F87171" FontSize="12"
                                        Padding="8,6" Margin="6,0,0,0" Cursor="Hand" BorderThickness="0">
                                    <Button.Style>
                                        <Style TargetType="Button">
                                            <Setter Property="Visibility" Value="{DynamicResource CardEditVis}"/>
                                            <Style.Triggers>
                                                <DataTrigger Binding="{Binding EmulatorSystem}" Value="{x:Null}">
                                                    <Setter Property="Visibility" Value="Collapsed"/>
                                                </DataTrigger>
                                            </Style.Triggers>
                                        </Style>
                                    </Button.Style>
                                    <Button.Resources>
                                        <Style TargetType="Border">
                                            <Setter Property="CornerRadius" Value="6"/>
                                        </Style>
                                    </Button.Resources>
                                </Button>
                                <!-- Remover jogo personalizado - só tira do GameHub, não apaga o arquivo real -->
                                <Button Grid.Column="1" Content="&#x1F5D1;&#xFE0F;" Click="RemoveCustomGameButton_Click" Tag="{Binding}"
                                        Background="#1F2233" Foreground="#9CA3AF" FontSize="12"
                                        Padding="8,6" Margin="6,0,0,0" Cursor="Hand" BorderThickness="0">
                                    <Button.Style>
                                        <Style TargetType="Button">
                                            <Setter Property="Visibility" Value="Collapsed"/>
                                            <Style.Triggers>
                                                <DataTrigger Binding="{Binding IsCustomGame}" Value="True">
                                                    <Setter Property="Visibility" Value="{DynamicResource CardEditVis}"/>
                                                </DataTrigger>
                                            </Style.Triggers>
                                        </Style>
                                    </Button.Style>
                                    <Button.Resources>
                                        <Style TargetType="Border">
                                            <Setter Property="CornerRadius" Value="6"/>
                                        </Style>
                                    </Button.Resources>
                                </Button>
                            </Grid>
                        </StackPanel>
                    </Border>
                </Grid>
            </Border>
        </DataTemplate>

        <!-- ═══════════════════════════════════════════════════════════
             Card: JOGO ADQUIRIDO (não instalado)
        ════════════════════════════════════════════════════════════ -->
        <DataTemplate x:Key="AcquiredGameCardTemplate">
            <Border Width="175" Height="230" Margin="0,0,14,14"
                    CornerRadius="12" ClipToBounds="True"
                    Background="#13141E" BorderBrush="#252838" BorderThickness="1" Opacity="0.85"
                    Cursor="Hand" MouseLeftButtonDown="Card_MouseLeftButtonDown" MouseEnter="Card_MouseEnter" ContextMenuOpening="GameCard_ContextMenuOpening" Tag="{Binding}"
                    RenderTransformOrigin="0.5,0.5">
                <Border.Clip>
                    <RectangleGeometry Rect="1,1,173,228" RadiusX="11" RadiusY="11"/>
                </Border.Clip>
                <Border.RenderTransform>
                    <ScaleTransform x:Name="AcquiredCardScale" ScaleX="1.0" ScaleY="1.0"/>
                </Border.RenderTransform>

                <Border.Style>
                    <Style TargetType="Border">
                        <Style.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter Property="Opacity" Value="1.0"/>
                                <Setter Property="Background" Value="#1A1C2B"/>
                                <Setter Property="BorderBrush" Value="#3B82F6"/>
                            </Trigger>
                        </Style.Triggers>
                    </Style>
                </Border.Style>

                <Border.Triggers>
                    <EventTrigger RoutedEvent="Border.MouseEnter">
                        <BeginStoryboard>
                            <Storyboard>
                                <DoubleAnimation Storyboard.TargetName="AcquiredCardScale" Storyboard.TargetProperty="ScaleX" To="1.05" Duration="0:0:0.15"/>
                                <DoubleAnimation Storyboard.TargetName="AcquiredCardScale" Storyboard.TargetProperty="ScaleY" To="1.05" Duration="0:0:0.15"/>
                            </Storyboard>
                        </BeginStoryboard>
                    </EventTrigger>
                    <EventTrigger RoutedEvent="Border.MouseLeave">
                        <BeginStoryboard>
                            <Storyboard>
                                <DoubleAnimation Storyboard.TargetName="AcquiredCardScale" Storyboard.TargetProperty="ScaleX" To="1.0" Duration="0:0:0.15"/>
                                <DoubleAnimation Storyboard.TargetName="AcquiredCardScale" Storyboard.TargetProperty="ScaleY" To="1.0" Duration="0:0:0.15"/>
                            </Storyboard>
                        </BeginStoryboard>
                    </EventTrigger>
                </Border.Triggers>

                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="*"/>
                        <RowDefinition Height="Auto"/>
                    </Grid.RowDefinitions>

                    <!-- Área da Capa -->
                    <Grid Grid.Row="0">
                        <Rectangle>
                            <Rectangle.Fill>
                                <LinearGradientBrush StartPoint="0,0" EndPoint="0,1">
                                    <GradientStop Color="#181E29" Offset="0.0"/>
                                    <GradientStop Color="#0D1117" Offset="1.0"/>
                                </LinearGradientBrush>
                            </Rectangle.Fill>
                        </Rectangle>
                        <Viewbox Margin="30">
                            <TextBlock Text="📦" Opacity="0.3"/>
                        </Viewbox>
                        <Image Source="{Binding CoverImage}" Stretch="UniformToFill"/>

                        <!-- Badges -->
                        <DockPanel VerticalAlignment="Top" Margin="8">
                            <Border DockPanel.Dock="Left" Background="#1F2937" CornerRadius="8" Padding="6,3">
                                <TextBlock Text="📦 ADQUIRIDO" FontSize="9" FontWeight="SemiBold" Foreground="#9CA3AF"/>
                            </Border>
                            <TextBlock DockPanel.Dock="Left" Text="&#x2605;" FontSize="15" Foreground="#FBBF24"
                                       Margin="5,0,0,0" VerticalAlignment="Center" IsHitTestVisible="False"
                                       Visibility="{Binding IsFavorite, Converter={StaticResource BoolToVis}}">
                                <TextBlock.Effect>
                                    <DropShadowEffect Color="Black" BlurRadius="4" ShadowDepth="0" Opacity="0.9"/>
                                </TextBlock.Effect>
                            </TextBlock>
                            <ItemsControl DockPanel.Dock="Right" ItemsSource="{Binding PlatformBadges}" HorizontalAlignment="Right">
                                <ItemsControl.ItemsPanel>
                                    <ItemsPanelTemplate>
                                        <StackPanel Orientation="Horizontal"/>
                                    </ItemsPanelTemplate>
                                </ItemsControl.ItemsPanel>
                                <ItemsControl.ItemTemplate>
                                    <DataTemplate>
                                        <Grid Width="20" Height="20" Margin="2,0,0,0">
                                            <Ellipse>
                                                <Ellipse.Fill>
                                                    <RadialGradientBrush>
                                                        <GradientStop Color="#00000000" Offset="0.5"/>
                                                        <GradientStop Color="#CC000000" Offset="1.0"/>
                                                    </RadialGradientBrush>
                                                </Ellipse.Fill>
                                            </Ellipse>
                                            <Image Source="{Binding IconPath}" Stretch="Uniform"
                                                   Margin="1" RenderOptions.BitmapScalingMode="HighQuality"/>
                                        </Grid>
                                    </DataTemplate>
                                </ItemsControl.ItemTemplate>
                            </ItemsControl>
                        </DockPanel>
                    </Grid>

                    <!-- Rodapé -->
                    <Border Grid.Row="1" Background="#0E0F16" Padding="10">
                        <TextBlock Text="{Binding Name}" FontSize="13" FontWeight="SemiBold" Foreground="#D1D5DB"
                                   TextTrimming="CharacterEllipsis" MaxHeight="36" TextWrapping="Wrap"
                                   TextAlignment="Center" VerticalAlignment="Center"/>
                    </Border>
                </Grid>
            </Border>
        </DataTemplate>

        <!-- Style dos Botões de Aba / Filtro por Plataforma -->
        <Style x:Key="PlatformTabButtonStyle" TargetType="RadioButton">
            <Setter Property="Foreground" Value="#9CA3AF"/>
            <Setter Property="Background" Value="#161824"/>
            <Setter Property="FontSize" Value="14"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="Padding" Value="16,7"/>
            <Setter Property="Margin" Value="0,0,8,0"/>
            <Setter Property="GroupName" Value="PlatformTabs"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="RadioButton">
                        <Border x:Name="Border" Background="{TemplateBinding Background}" CornerRadius="8" Padding="{TemplateBinding Padding}">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsChecked" Value="True">
                                <Setter TargetName="Border" Property="Background" Value="#3B82F6"/>
                                <Setter Property="Foreground" Value="White"/>
                            </Trigger>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Border" Property="Background" Value="#222538"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
        <Style x:Key="TitleBarButtonStyle" TargetType="Button">
            <Setter Property="Background" Value="Transparent"/>
            <Setter Property="Foreground" Value="#9CA3AF"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="Width" Value="45"/>
            <Setter Property="FontFamily" Value="Segoe Fluent Icons, Segoe MDL2 Assets"/>
            <Setter Property="FontSize" Value="10"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border Background="{TemplateBinding Background}">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter Property="Background" Value="#33FFFFFF"/>
                                <Setter Property="Foreground" Value="White"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
        <Style x:Key="TitleBarCloseButtonStyle" TargetType="Button" BasedOn="{StaticResource TitleBarButtonStyle}">
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border Background="{TemplateBinding Background}">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter Property="Background" Value="#E81123"/>
                                <Setter Property="Foreground" Value="White"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
                <!-- Barra de rolagem fina, no estilo do programa -->
        <Style x:Key="ScrollThumbStyle" TargetType="Thumb">
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Thumb">
                        <Border x:Name="Th" CornerRadius="4" Background="#3A3F55" Margin="3"/>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Th" Property="Background" Value="#10B981"/>
                            </Trigger>
                            <Trigger Property="IsDragging" Value="True">
                                <Setter TargetName="Th" Property="Background" Value="#34D399"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
        <Style x:Key="ScrollPageButtonStyle" TargetType="RepeatButton">
            <Setter Property="IsTabStop" Value="False"/>
            <Setter Property="Focusable" Value="False"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="RepeatButton">
                        <Border Background="Transparent"/>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
        <Style TargetType="ScrollBar">
            <Setter Property="Background" Value="Transparent"/>
            <Setter Property="Width" Value="14"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="ScrollBar">
                        <Border Background="#0DFFFFFF" CornerRadius="7">
                            <Track x:Name="PART_Track" IsDirectionReversed="True">
                                <Track.DecreaseRepeatButton>
                                    <RepeatButton Style="{StaticResource ScrollPageButtonStyle}" Command="ScrollBar.PageUpCommand"/>
                                </Track.DecreaseRepeatButton>
                                <Track.Thumb>
                                    <Thumb Style="{StaticResource ScrollThumbStyle}" MinHeight="36"/>
                                </Track.Thumb>
                                <Track.IncreaseRepeatButton>
                                    <RepeatButton Style="{StaticResource ScrollPageButtonStyle}" Command="ScrollBar.PageDownCommand"/>
                                </Track.IncreaseRepeatButton>
                            </Track>
                        </Border>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
            <Style.Triggers>
                <Trigger Property="Orientation" Value="Horizontal">
                    <Setter Property="Width" Value="Auto"/>
                    <Setter Property="Height" Value="14"/>
                    <Setter Property="Template">
                        <Setter.Value>
                            <ControlTemplate TargetType="ScrollBar">
                                <Border Background="#0DFFFFFF" CornerRadius="7">
                                    <Track x:Name="PART_Track">
                                        <Track.DecreaseRepeatButton>
                                            <RepeatButton Style="{StaticResource ScrollPageButtonStyle}" Command="ScrollBar.PageLeftCommand"/>
                                        </Track.DecreaseRepeatButton>
                                        <Track.Thumb>
                                            <Thumb Style="{StaticResource ScrollThumbStyle}" MinWidth="36"/>
                                        </Track.Thumb>
                                        <Track.IncreaseRepeatButton>
                                            <RepeatButton Style="{StaticResource ScrollPageButtonStyle}" Command="ScrollBar.PageRightCommand"/>
                                        </Track.IncreaseRepeatButton>
                                    </Track>
                                </Border>
                            </ControlTemplate>
                        </Setter.Value>
                    </Setter>
                </Trigger>
            </Style.Triggers>
        </Style>
        <!-- Menu do botão direito e tooltips no tema escuro -->
        <Style x:Key="DarkContextMenuStyle" TargetType="ContextMenu">
            <Setter Property="OverridesDefaultStyle" Value="True"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="ContextMenu">
                        <Border Background="#F0161824" BorderBrush="#2A2D3F" BorderThickness="1"
                                CornerRadius="10" Padding="4">
                            <StackPanel IsItemsHost="True" KeyboardNavigation.DirectionalNavigation="Cycle"/>
                        </Border>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
        <Style x:Key="DarkMenuItemStyle" TargetType="MenuItem">
            <Setter Property="OverridesDefaultStyle" Value="True"/>
            <Setter Property="Foreground" Value="#E5E7EB"/>
            <Setter Property="FontSize" Value="13"/>
            <Setter Property="Padding" Value="14,8"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="MenuItem">
                        <Border x:Name="Bd" Background="Transparent" CornerRadius="7"
                                Padding="{TemplateBinding Padding}" SnapsToDevicePixels="True">
                            <ContentPresenter ContentSource="Header" RecognizesAccessKey="False" VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsHighlighted" Value="True">
                                <Setter TargetName="Bd" Property="Background" Value="#3310B981"/>
                            </Trigger>
                            <Trigger Property="IsEnabled" Value="False">
                                <Setter Property="Foreground" Value="#9CA3AF"/>
                                <Setter Property="Cursor" Value="Arrow"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
        <Style x:Key="DarkMenuSeparatorStyle" TargetType="Separator">
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Separator">
                        <Border Height="1" Background="#2A2D3F" Margin="6,4"/>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
        <Style TargetType="ToolTip">
            <Setter Property="OverridesDefaultStyle" Value="True"/>
            <Setter Property="FontFamily" Value="Segoe UI"/>
            <Setter Property="Foreground" Value="#E5E7EB"/>
            <Setter Property="FontSize" Value="12"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="ToolTip">
                        <Border Background="#F0161824" BorderBrush="#2A2D3F" BorderThickness="1"
                                CornerRadius="8" Padding="10,6">
                            <ContentPresenter/>
                        </Border>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
    </Window.Resources>

    <!-- Root único: fundo dinâmico blur + barra de título + conteúdo -->
    <Grid>
        <!-- Fundo: base escura + imagem com blur -->
        <Rectangle Fill="#0A0B10"/>
        <Image x:Name="DynamicBgImage" Stretch="UniformToFill" Opacity="0.18"
               RenderOptions.BitmapScalingMode="Linear"/>
                    <Rectangle x:Name="BgTint" Visibility="Collapsed"/>
        <Rectangle x:Name="BgShade">
            <Rectangle.Fill>
                <LinearGradientBrush StartPoint="0,0" EndPoint="0,1">
                    <GradientStop Color="#A00A0B10" Offset="0"/>
                    <GradientStop Color="#F00A0B10" Offset="1"/>
                </LinearGradientBrush>
            </Rectangle.Fill>
        </Rectangle>

        <!-- Camada de conteúdo (title bar + área principal) -->
        <Grid>
            <Grid.RowDefinitions>
                <RowDefinition Height="35"/>
                <RowDefinition Height="*"/>
            </Grid.RowDefinitions>

        <!-- Custom Title Bar -->
        <Grid x:Name="TitleBar" Grid.Row="0" Background="#0D0F1B">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="Auto"/>
            </Grid.ColumnDefinitions>
            <Rectangle Height="1" VerticalAlignment="Bottom" Fill="#1E2236" Grid.ColumnSpan="2"/>
            <StackPanel Orientation="Horizontal" VerticalAlignment="Center" Margin="14,0,0,0">
                <TextBlock Text="&#x1F3AE; GameHub" Foreground="#9CA3AF" FontSize="12" FontWeight="SemiBold"/>
            </StackPanel>
            <StackPanel Grid.Column="1" Orientation="Horizontal" WindowChrome.IsHitTestVisibleInChrome="True" Height="35">
                <Button Click="BtnMinimize_Click" Content="&#xE921;" Style="{StaticResource TitleBarButtonStyle}"/>
                <Button x:Name="MaximizeButton" Click="BtnMaximize_Click" Content="&#xE922;" Style="{StaticResource TitleBarButtonStyle}"/>
                <Button Click="BtnClose_Click" Content="&#xE8BB;" Style="{StaticResource TitleBarCloseButtonStyle}"/>
            </StackPanel>
        </Grid>

        <!-- Root Grid Antigo -->
        <Grid Grid.Row="1">

        <!-- ══════ Conteúdo principal (lista de jogos) ══════ -->
        <Grid Margin="22,12,22,22">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/> <!-- Top Bar -->
                <RowDefinition Height="Auto"/> <!-- Search Bar -->
                <RowDefinition Height="Auto"/> <!-- Platform Tabs -->
                <RowDefinition Height="*"/>    <!-- Scrollable Cards Area -->
            </Grid.RowDefinitions>

            <!-- Overlay de Carregamento -->
            <Border x:Name="LoadingOverlay" Grid.RowSpan="4" Background="#0B0C10" Panel.ZIndex="90" Visibility="Collapsed">
                <StackPanel HorizontalAlignment="Center" VerticalAlignment="Center">
                    <TextBlock Text="🎮 GameHub" FontSize="38" FontWeight="Bold" Foreground="#F3F4F6" HorizontalAlignment="Center" Margin="0,0,0,15"/>
                    <ProgressBar IsIndeterminate="True" Width="240" Height="6" Foreground="#3B82F6" Background="#1F2937" BorderThickness="0" Margin="0,15,0,18"/>
                    <TextBlock x:Name="LoadingStatusText" Text="Carregando sua biblioteca de jogos..." FontSize="16" FontWeight="SemiBold" Foreground="#9CA3AF" HorizontalAlignment="Center"/>
                    <TextBlock x:Name="LoadingSubText" Text="Sincronizando plataformas..." FontSize="12" Foreground="#6B7280" HorizontalAlignment="Center" Margin="0,6,0,0"/>
                </StackPanel>
            </Border>

            <!-- Aviso rápido (toast) -->
            <Border x:Name="ToastBar" Grid.RowSpan="4" Panel.ZIndex="95" Visibility="Collapsed"
                    HorizontalAlignment="Center" VerticalAlignment="Bottom" Margin="0,0,0,72"
                    Padding="20,12" CornerRadius="22" Background="#F00C0E14"
                    BorderBrush="#10B981" BorderThickness="1.5" IsHitTestVisible="False">
                <StackPanel Orientation="Horizontal">
                    <TextBlock Text="&#xE73E;" FontFamily="Segoe Fluent Icons, Segoe MDL2 Assets" FontSize="16"
                               Foreground="#10B981" VerticalAlignment="Center" Margin="0,0,10,0"/>
                    <TextBlock x:Name="ToastText" FontSize="14" FontWeight="SemiBold"
                               Foreground="#F3F4F6" VerticalAlignment="Center"/>
                </StackPanel>
            </Border>

            <!-- Barra do topo -->
            <Grid Grid.Row="0" Margin="10,6,10,12">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="*"/>
                </Grid.ColumnDefinitions>

                <StackPanel Grid.Column="0" VerticalAlignment="Center" HorizontalAlignment="Left">
                    <TextBlock Text="GameHub" FontSize="18" FontWeight="Bold" Foreground="#F3F4F6"/>
                    <StackPanel Orientation="Horizontal" Margin="0,2,0,0">
                        <TextBlock x:Name="TotalInstalledText" Text="0" FontSize="12" Foreground="#B6BCC8"/>
                        <TextBlock Text=" instalados" FontSize="12" Foreground="#B6BCC8"/>
                    </StackPanel>
                    <TextBlock x:Name="TotalAcquiredText" Text="0" Visibility="Collapsed"/>
                </StackPanel>

                <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center">
                    <Button x:Name="NavHomeButton" Style="{StaticResource TopIconStyle}" Content="&#xE80F;"
                            Tag="Início" ToolTip="Início" Click="NavTab_Click"/>
                    <Button x:Name="NavPlatformsButton" Style="{StaticResource TopIconStyle}" Content="&#xE81E;"
                            ToolTip="Plataformas" Click="NavPlatforms_Click"/>
                    <Button x:Name="NavEmuButton" Style="{StaticResource TopIconStyle}" Content="&#xE7F4;"
                            ToolTip="Emuladores" Click="NavEmu_Click"/> 
                    <Button x:Name="NavCollectionsButton" Style="{StaticResource TopIconStyle}" Content="&#xE8F1;"
                            ToolTip="Coleções" Click="NavCollections_Click"/>       
                    <Button x:Name="NavFavButton" Style="{StaticResource TopIconStyle}" Content="&#xE734;"
                            Tag="Favoritos" ToolTip="Favoritos" Click="NavTab_Click"/>
                    <Button x:Name="NavSearchButton" Style="{StaticResource TopIconStyle}" Content="&#xE721;"
                            ToolTip="Buscar" Click="NavSearch_Click"/>
                    <Button x:Name="SettingsButton" Style="{StaticResource TopIconStyle}" Content="&#xE713;"
                            ToolTip="Ajustes" Click="SettingsButton_Click"/>
                </StackPanel>

                <StackPanel Grid.Column="2" Orientation="Horizontal" HorizontalAlignment="Right" VerticalAlignment="Center">
                    <Border x:Name="ControllerBatteryPill" Margin="0,0,20,0">
                        <StackPanel Orientation="Horizontal">
                            <TextBlock Text="&#xE7FC;" FontFamily="Segoe Fluent Icons, Segoe MDL2 Assets" FontSize="18"
                                       Foreground="#D1D5DB" VerticalAlignment="Center" Margin="0,0,8,0"/>
                            <TextBlock x:Name="ControllerBatteryText" Text="sem controle" FontSize="13"
                                       Foreground="#9CA3AF" VerticalAlignment="Center"/>
                        </StackPanel>
                    </Border>
                    <TextBlock x:Name="ClockText" Text="00:00" FontSize="18" FontWeight="SemiBold"
                               Foreground="#F3F4F6" VerticalAlignment="Center"/>
                </StackPanel>
            </Grid>

            <!-- Plataformas (chips) e busca: só aparecem quando abertos -->
            <StackPanel Grid.Row="1" HorizontalAlignment="Center">
                <Border x:Name="TopChipsBar" Visibility="Collapsed" Background="#B30C0E14" CornerRadius="26"
                        Padding="6,6,0,6" Margin="0,0,0,10">
                    <StackPanel x:Name="TopChips" Orientation="Horizontal">
                        <Button Style="{StaticResource TopChipStyle}" Content="Steam" Tag="Steam" Click="TopChip_Click"/>
                        <Button Style="{StaticResource TopChipStyle}" Content="Epic Games" Tag="Epic Games" Click="TopChip_Click"/>
                        <Button Style="{StaticResource TopChipStyle}" Content="GOG" Tag="GOG" Click="TopChip_Click"/>
                        <Button Style="{StaticResource TopChipStyle}" Content="EA App" Tag="EA App" Click="TopChip_Click"/>
                        <Button Style="{StaticResource TopChipStyle}" Content="Ubisoft" Tag="Ubisoft" Click="TopChip_Click"/>
                    </StackPanel>
                </Border>
                <Border x:Name="EmuChipsBar" Visibility="Collapsed" Background="#B30C0E14" CornerRadius="26"
                        Padding="6,6,0,0" Margin="0,0,0,10" MaxWidth="1000">
                    <WrapPanel x:Name="EmuChips" Orientation="Horizontal"/>
                </Border>
                <Border x:Name="CollectionChipsBar" Visibility="Collapsed" Background="#B30C0E14" CornerRadius="26"
                        Padding="6,6,0,0" Margin="0,0,0,10" MaxWidth="1000">
                    <WrapPanel x:Name="CollectionChips" Orientation="Horizontal"/>
                </Border>
                <Border x:Name="SearchBar" Visibility="Collapsed" Width="460" Margin="0,0,0,10">
                    <TextBox x:Name="SearchBox" Style="{StaticResource SearchTextBoxStyle}"
                             TextChanged="SearchBox_TextChanged" PreviewKeyDown="SearchBox_PreviewKeyDown"
                             LostKeyboardFocus="SearchBox_LostKeyboardFocus"/>
                </Border>
                <Border x:Name="SettingsBar" UseLayoutRounding="True" SnapsToDevicePixels="True" Visibility="Collapsed" Background="#B30C0E14" CornerRadius="26"
                        Padding="6,6,0,6" Margin="0,0,0,10" HorizontalAlignment="Center">
                    <StackPanel Orientation="Horizontal">
                        <Button x:Name="SortButton" Content="&#x2195; Ordem: Nome" Click="SortButton_Click"
                                Style="{StaticResource TopChipStyle}"/>
                        <Button x:Name="HiddenButton" Content="Ocultos" Click="HiddenButton_Click"
                                Style="{StaticResource TopChipStyle}"/>
                        <Button x:Name="RefreshBtn" Content="&#x1F504; Recarregar" Click="RefreshButton_Click"
                                Style="{StaticResource TopChipStyle}"/>
                        <Button x:Name="FetchBgButton" Content="Buscar fundos" Click="FetchBackgrounds_Click"
                                Style="{StaticResource TopChipStyle}"/>
                        <Button x:Name="DuplicatesButton" Content="Duplicados" Click="DuplicatesButton_Click"
                                Style="{StaticResource TopChipStyle}"/>
                    </StackPanel>
                </Border>
            </StackPanel>

            <!-- Platform Tabs -->
            <StackPanel x:Name="PlatformTabs" Grid.Row="2" Orientation="Horizontal" Margin="0,0,0,12" Visibility="Collapsed">
                <RadioButton Content="Início" Style="{StaticResource PlatformTabButtonStyle}" Checked="PlatformTab_Checked"/>
                <RadioButton Content="Todos" IsChecked="True" Style="{StaticResource PlatformTabButtonStyle}" Checked="PlatformTab_Checked"/>
                <RadioButton Content="Instalados" Style="{StaticResource PlatformTabButtonStyle}" Checked="PlatformTab_Checked"/>
                <RadioButton Content="Adquiridos" Style="{StaticResource PlatformTabButtonStyle}" Checked="PlatformTab_Checked"/>
                <RadioButton Content="Favoritos" Style="{StaticResource PlatformTabButtonStyle}" Checked="PlatformTab_Checked"/>
                <RadioButton Content="Steam" Style="{StaticResource PlatformTabButtonStyle}" Checked="PlatformTab_Checked"/>
                <RadioButton Content="Epic Games" Style="{StaticResource PlatformTabButtonStyle}" Checked="PlatformTab_Checked"/>
                <RadioButton Content="GOG" Style="{StaticResource PlatformTabButtonStyle}" Checked="PlatformTab_Checked"/>
                <RadioButton Content="EA App" Style="{StaticResource PlatformTabButtonStyle}" Checked="PlatformTab_Checked"/>
                <RadioButton Content="Ubisoft" Style="{StaticResource PlatformTabButtonStyle}" Checked="PlatformTab_Checked"/>
                <RadioButton Content="Emuladores" Style="{StaticResource PlatformTabButtonStyle}" Checked="PlatformTab_Checked"/>
                <RadioButton Content="Modificados" Style="{StaticResource PlatformTabButtonStyle}" Checked="PlatformTab_Checked"/>
            </StackPanel>
                        <!-- Início (estilo console) -->
                        <Grid x:Name="HomeView" Grid.Row="3" Visibility="Collapsed">
                <Grid.Resources>
                    <Style x:Key="ShortcutTile" TargetType="Border">
                        <Setter Property="Width" Value="216"/>
                        <Setter Property="Height" Value="118"/>
                        <Setter Property="Margin" Value="0,0,16,0"/>
                        <Setter Property="CornerRadius" Value="10"/>
                        <Setter Property="BorderThickness" Value="2"/>
                        <Setter Property="BorderBrush" Value="Transparent"/>
                        <Setter Property="Cursor" Value="Hand"/>
                        <EventSetter Event="MouseLeftButtonDown" Handler="Shortcut_Click"/>
                        <EventSetter Event="MouseEnter" Handler="Shortcut_MouseEnter"/>
                        <EventSetter Event="MouseLeave" Handler="Shortcut_MouseLeave"/>
                    </Style>
                    <Style x:Key="ShortcutLabel" TargetType="TextBlock">
                        <Setter Property="FontSize" Value="15"/>
                        <Setter Property="FontWeight" Value="SemiBold"/>
                        <Setter Property="Foreground" Value="#F3F4F6"/>
                    </Style>
                    <LinearGradientBrush x:Key="ShortcutShade" StartPoint="0,0" EndPoint="0,1">
                        <GradientStop Color="#33000000" Offset="0"/>
                        <GradientStop Color="#B3000000" Offset="1"/>
                    </LinearGradientBrush>
                </Grid.Resources>
                <Grid.RowDefinitions>
                    <RowDefinition Height="*"/>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                </Grid.RowDefinitions>

                <StackPanel Grid.Row="0" VerticalAlignment="Bottom" Margin="12,0,0,22">
                    <TextBlock x:Name="HomeTitleText" FontSize="40" FontWeight="Bold" Foreground="#F3F4F6"
                               TextTrimming="CharacterEllipsis"/>
                    <TextBlock x:Name="HomeSubText" FontSize="14" Foreground="#C5CBD6" Margin="0,8,0,16"/>
                    <Button x:Name="HomePlayButton" Content="&#x25B6;  Jogar" Click="HomePlayButton_Click"
                            HorizontalAlignment="Left" Padding="30,12" FontSize="15" FontWeight="Bold"
                            Foreground="White" Background="#10B981" BorderThickness="0" Cursor="Hand">
                        <Button.Resources>
                            <Style TargetType="Border">
                                <Setter Property="CornerRadius" Value="10"/>
                            </Style>
                        </Button.Resources>
                    </Button>
                </StackPanel>

                <Grid Grid.Row="1">
                    <ScrollViewer x:Name="HomeScroll" Margin="-22,0,-22,0" HorizontalScrollBarVisibility="Hidden"
                                  VerticalScrollBarVisibility="Disabled" CanContentScroll="False"
                                  PreviewMouseWheel="HomeScroll_PreviewMouseWheel"
                                  ScrollChanged="HomeScroll_ScrollChanged">
                        <StackPanel Orientation="Horizontal" Margin="34,36,34,36">
                            <ItemsControl x:Name="HomeTilesList" ItemTemplate="{StaticResource HomeTileTemplate}">
                                <ItemsControl.ItemsPanel>
                                    <ItemsPanelTemplate>
                                        <StackPanel Orientation="Horizontal" IsItemsHost="True"/>
                                    </ItemsPanelTemplate>
                                </ItemsControl.ItemsPanel>
                            </ItemsControl>
                            <Border x:Name="HomeSeeAllTile" Style="{StaticResource ShortcutTile}"
                                    Width="150" Height="150" Tag="Instalados" Background="#161824">
                                <StackPanel VerticalAlignment="Center" HorizontalAlignment="Center">
                                    <TextBlock Text="&#xE76C;" FontFamily="Segoe Fluent Icons, Segoe MDL2 Assets"
                                               FontSize="26" Foreground="#D1D5DB" HorizontalAlignment="Center"/>
                                    <TextBlock Text="Ver todos" Style="{StaticResource ShortcutLabel}"
                                               Margin="0,8,0,0" HorizontalAlignment="Center"/>
                                </StackPanel>
                            </Border>
                        </StackPanel>
                    </ScrollViewer>

                    <Button x:Name="HomeArrowLeft" Style="{StaticResource TopIconStyle}" Content="&#xE76B;"
                            Tag="-1" Click="HomeArrow_Click" Visibility="Collapsed" Background="#CC0C0E14"
                            HorizontalAlignment="Left" VerticalAlignment="Center" Margin="4,0,0,0"/>
                    <Button x:Name="HomeArrowRight" Style="{StaticResource TopIconStyle}" Content="&#xE76C;"
                            Tag="1" Click="HomeArrow_Click" Visibility="Collapsed" Background="#CC0C0E14"
                            HorizontalAlignment="Right" VerticalAlignment="Center" Margin="0,0,4,0"/>
                </Grid>

                  <!-- Atalhos -->
                <StackPanel Grid.Row="2" Orientation="Horizontal" Margin="12,6,6,36">
                    <Border x:Name="ScAll" Style="{StaticResource ShortcutTile}" Tag="Instalados" Width="250" Height="114">
                        <Border.Background>
                            <LinearGradientBrush StartPoint="0,0" EndPoint="1,1">
                                <GradientStop Color="#0B3B2C" Offset="0"/><GradientStop Color="#0E1F1A" Offset="1"/>
                            </LinearGradientBrush>
                        </Border.Background>
                        <Grid>
                            <Grid.Clip>
                                <RectangleGeometry Rect="0,0,250,114" RadiusX="8" RadiusY="8"/>
                            </Grid.Clip>
                            <Image x:Name="ScAllArt" Stretch="UniformToFill" Opacity="0"/>
                            <Border x:Name="ScAllShade" Visibility="Collapsed" Background="{StaticResource ShortcutShade}"/>
                            <TextBlock Style="{StaticResource ShortcutLabel}" Text="Instalados"
                                       VerticalAlignment="Bottom" Margin="16,0,16,12"/>
                        </Grid>
                    </Border>
                    <Border x:Name="ScMod" Style="{StaticResource ShortcutTile}" Tag="Modificados" Width="250" Height="114">
                        <Border.Background>
                            <LinearGradientBrush StartPoint="0,0" EndPoint="1,1">
                                <GradientStop Color="#2C2140" Offset="0"/><GradientStop Color="#15121F" Offset="1"/>
                            </LinearGradientBrush>
                        </Border.Background>
                        <Grid>
                            <Grid.Clip>
                                <RectangleGeometry Rect="0,0,250,114" RadiusX="8" RadiusY="8"/>
                            </Grid.Clip>
                            <Image x:Name="ScModArt" Stretch="UniformToFill" Opacity="0"/>
                            <Border x:Name="ScModShade" Visibility="Collapsed" Background="{StaticResource ShortcutShade}"/>
                            <TextBlock Style="{StaticResource ShortcutLabel}" Text="Modificados"
                                       VerticalAlignment="Bottom" Margin="16,0,16,12"/>
                        </Grid>
                    </Border>
                    <Border x:Name="ScAcq" Style="{StaticResource ShortcutTile}" Tag="Adquiridos" Width="250" Height="114">
                        <Border.Background>
                            <LinearGradientBrush StartPoint="0,0" EndPoint="1,1">
                                <GradientStop Color="#1B2A3E" Offset="0"/><GradientStop Color="#10141C" Offset="1"/>
                            </LinearGradientBrush>
                        </Border.Background>
                        <Grid>
                            <Grid.Clip>
                                <RectangleGeometry Rect="0,0,250,114" RadiusX="8" RadiusY="8"/>
                            </Grid.Clip>
                            <Image x:Name="ScAcqArt" Stretch="UniformToFill" Opacity="0"/>
                            <Border x:Name="ScAcqShade" Visibility="Collapsed" Background="{StaticResource ShortcutShade}"/>
                            <StackPanel Orientation="Horizontal" VerticalAlignment="Bottom" Margin="16,0,16,12">
                                <TextBlock Style="{StaticResource ShortcutLabel}" Text="Adquiridos"/>
                                <TextBlock x:Name="ScAcqCount" Text="" FontSize="13" Foreground="#C5CBD6"
                                           VerticalAlignment="Bottom" Margin="8,0,0,1"/>
                            </StackPanel>
                        </Grid>
                    </Border>
                    <Border x:Name="ScStats" Style="{StaticResource ShortcutTile}" Tag="Estatisticas" Width="250" Height="114">
                        <Border.Background>
                            <LinearGradientBrush StartPoint="0,0" EndPoint="1,1">
                                <GradientStop Color="#3A2A10" Offset="0"/><GradientStop Color="#17110A" Offset="1"/>
                            </LinearGradientBrush>
                        </Border.Background>
                        <Grid>
                            <Grid.Clip>
                                <RectangleGeometry Rect="0,0,250,114" RadiusX="8" RadiusY="8"/>
                            </Grid.Clip>
                            <TextBlock Text="&#xE9D9;" FontFamily="Segoe Fluent Icons, Segoe MDL2 Assets" FontSize="64"
                                       Foreground="White" Opacity="0.08" HorizontalAlignment="Right" VerticalAlignment="Top"
                                       Margin="0,6,10,0" IsHitTestVisible="False"/>
                            <StackPanel Orientation="Horizontal" VerticalAlignment="Bottom" Margin="16,0,16,12">
                                <TextBlock Style="{StaticResource ShortcutLabel}" Text="Estatísticas"/>
                                <TextBlock x:Name="ScStatsHours" Text="" FontSize="13" Foreground="#E7C98A"
                                           VerticalAlignment="Bottom" Margin="8,0,0,1"/>
                            </StackPanel>
                        </Grid>
                    </Border>
                </StackPanel>
            </Grid>
                        <!-- Cabeçalho fixo das telas de lista: nome, tempo e última sessão do jogo em foco -->
            <Grid x:Name="GridBanner" Grid.Row="3" Height="170" VerticalAlignment="Top" Visibility="Collapsed">
                <StackPanel VerticalAlignment="Bottom" Margin="8,0,0,14">
                    <TextBlock x:Name="GridBannerTitle" FontSize="30" FontWeight="Bold"
                               Foreground="#F3F4F6" TextTrimming="CharacterEllipsis"/>
                    <TextBlock x:Name="GridBannerSub" FontSize="13" Foreground="#C5CBD6" Margin="0,6,0,0"/>
                </StackPanel>
            </Grid>

            <!-- Main ScrollViewer: só os cards rolam, abaixo do cabeçalho -->
            <ScrollViewer Grid.Row="3" x:Name="MainScrollViewer" Margin="0,176,0,0" FocusVisualStyle="{x:Null}" VerticalScrollBarVisibility="Auto" CanContentScroll="False">
                <StackPanel Margin="0,0,10,64">
                    <!-- Seção: Instalados -->
                    <Border x:Name="InstalledSection" Background="#C811131C" CornerRadius="12" Padding="18" Margin="0,0,0,18">
                        <StackPanel>
                            <DockPanel Margin="0,0,0,16">
                                    <Button x:Name="AddCustomGameButton" DockPanel.Dock="Right" Content="+  Adicionar jogo"
                                        Style="{StaticResource TopChipStyle}"
                                        Click="AddCustomGameButton_Click" Visibility="Collapsed"
                                        Background="#10B981" Foreground="White" FontSize="13"
                                        Padding="16,8" Margin="0" HorizontalAlignment="Right"/>
                                <TextBlock Text="🎮 JOGOS INSTALADOS" x:Name="InstalledHeaderTitle" FontSize="16" FontWeight="Bold" Foreground="#10B981"/>
                                <TextBlock x:Name="InstalledHeaderCount" Text="(0)" FontSize="15" Foreground="#6B7280" Margin="8,0,0,0"/>
                            </DockPanel>
                            <ItemsControl x:Name="InstalledGamesList"
                                          ItemTemplate="{StaticResource InstalledGameCardTemplate}">
                                <ItemsControl.ItemsPanel>
                                    <ItemsPanelTemplate>
                                        <WrapPanel IsItemsHost="True"/>
                                    </ItemsPanelTemplate>
                                </ItemsControl.ItemsPanel>
                            </ItemsControl>
                        </StackPanel>
                    </Border>

                    <!-- Seção: Emuladores - uma sub-seção por console, montada em code-behind -->
                    <StackPanel x:Name="EmulatorSection" Visibility="Collapsed"/>

                    <!-- Seção: Adquiridos -->
                    <Border x:Name="AcquiredSection" Background="#C80F1018" CornerRadius="12" Padding="18">
                        <StackPanel>
                            <DockPanel Margin="0,0,0,16">
                                <TextBlock Text="📦 JOGOS ADQUIRIDOS (BIBLIOTECA)" FontSize="16" FontWeight="Bold" Foreground="#9CA3AF"/>
                                <TextBlock x:Name="AcquiredHeaderCount" Text="(0)" FontSize="15" Foreground="#6B7280" Margin="8,0,0,0"/>
                            </DockPanel>
                            <ItemsControl x:Name="AcquiredGamesList"
                                          ItemTemplate="{StaticResource AcquiredGameCardTemplate}">
                                <ItemsControl.ItemsPanel>
                                    <ItemsPanelTemplate>
                                        <WrapPanel IsItemsHost="True"/>
                                    </ItemsPanelTemplate>
                                </ItemsControl.ItemsPanel>
                            </ItemsControl>
                        </StackPanel>
                    </Border>
                </StackPanel>
            </ScrollViewer>
        </Grid>

        <!-- ══════════════════════════════════════════════════════════
             PAINEL DE DETALHE INLINE (sobrepõe a tela, desliza da direita)
        ══════════════════════════════════════════════════════════ -->
        <Grid x:Name="DetailPanelRoot" Visibility="Collapsed" Panel.ZIndex="50">

            <!-- Fundo escurecido com click para fechar -->
            <Rectangle Fill="#000000" Opacity="0.55" MouseLeftButtonDown="DetailOverlay_Click"/>

            <!-- Painel deslizante à direita -->
            <Border x:Name="DetailPanel"
                    Width="680" HorizontalAlignment="Right"
                    Background="#0D0F1B"
                    BorderBrush="#1E2236" BorderThickness="1,0,0,0">
                <Border.RenderTransform>
                    <TranslateTransform x:Name="DetailPanelTranslate" X="700"/>
                </Border.RenderTransform>
 
                <Grid>
                    <!-- Faixa do topo: plano de fundo do jogo (sem fundo, o código usa a capa desfocada) -->
                    <Grid x:Name="HeroGrid" Height="270" VerticalAlignment="Top">
                        <Image x:Name="HeroBgImage" Stretch="UniformToFill" VerticalAlignment="Top" Opacity="0.3"/>
                        <Rectangle>
                            <Rectangle.Fill>
                                <LinearGradientBrush StartPoint="0,0" EndPoint="0,1">
                                    <GradientStop Color="#990D0F1B" Offset="0.0"/>
                                    <GradientStop Color="#000D0F1B" Offset="0.4"/>
                                    <GradientStop Color="#D90D0F1B" Offset="0.8"/>
                                    <GradientStop Color="#0D0F1B" Offset="1.0"/>
                                </LinearGradientBrush>
                            </Rectangle.Fill>
                        </Rectangle>
                    </Grid>
 
                    <!-- Botão fechar -->
                    <Button x:Name="CloseDetailButton" Content="&#x2715;" Click="CloseDetail_Click"
                            HorizontalAlignment="Right" VerticalAlignment="Top"
                            Margin="0,14,14,0" Width="34" Height="34"
                            Background="#CC1E2236" Foreground="#D1D5DB" FontSize="14" FontWeight="Bold"
                            BorderThickness="0" Cursor="Hand" Panel.ZIndex="10">
                        <Button.Resources>
                            <Style TargetType="Border">
                                <Setter Property="CornerRadius" Value="17"/>
                            </Style>
                        </Button.Resources>
                    </Button>
 
                    <!-- Conteúdo do painel -->
                    <ScrollViewer x:Name="DetailScroll" VerticalScrollBarVisibility="Auto" FocusVisualStyle="{x:Null}">
                        <StackPanel Margin="28,150,28,70">
 
                            <!-- Capa + título, gêneros e lojas -->
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="160"/>
                                    <ColumnDefinition Width="*"/>
                                </Grid.ColumnDefinitions>
 
                                <Border Width="160" Height="226" CornerRadius="12" ClipToBounds="True"
                                        VerticalAlignment="Top"
                                        BorderBrush="#2A2D3F" BorderThickness="1.5" Background="#161824">
                                    <Border.Effect>
                                        <DropShadowEffect Color="#000000" BlurRadius="24" ShadowDepth="6" Opacity="0.6"/>
                                    </Border.Effect>
                                    <!-- Recorte inset pela borda (160 - 2x1,5 = 157; 226 - 3 = 223; raio 12 - 1,5 = 10,5) -->
                                    <Border.Clip>
                                        <RectangleGeometry Rect="1.5,1.5,157,223" RadiusX="10.5" RadiusY="10.5"/>
                                    </Border.Clip>
                                    <Grid>
                                        <Viewbox Margin="35">
                                            <TextBlock Text="🎮" Opacity="0.2"/>
                                        </Viewbox>
                                        <Image x:Name="DetailCoverImage" Stretch="UniformToFill"/>
                                    </Grid>
                                </Border>
 
                                <StackPanel Grid.Column="1" Margin="22,64,0,0">
                                    <TextBlock x:Name="DetailTitleText" Text="Nome do Jogo"
                                               FontSize="26" FontWeight="Bold" Foreground="#F3F4F6"
                                               TextWrapping="Wrap" Margin="0,0,40,0"/>
                                    <WrapPanel x:Name="DetailGenrePanel" Margin="0,10,0,0"/>
                                    <StackPanel Orientation="Horizontal" Margin="0,6,0,0">
                                        <TextBlock Text="DISPON&#xCD;VEL EM" FontSize="10" FontWeight="Bold"
                                                   Foreground="#6B7280" VerticalAlignment="Center" Margin="0,0,10,6"/>
                                        <WrapPanel x:Name="DetailPlatformPanel" VerticalAlignment="Center"/>
                                    </StackPanel>
                                </StackPanel>
                            </Grid>
 
                            <!-- Ações principais -->
                            <Grid Margin="0,20,0,0">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="Auto"/>
                                    <ColumnDefinition Width="Auto"/>
                                </Grid.ColumnDefinitions>
 
                                <Button x:Name="DetailPlayButton" Content="&#x25B6;  JOGAR AGORA"
                                        Click="DetailPlayButton_Click"
                                        Foreground="White" FontWeight="Bold" FontSize="14"
                                        Padding="0,12" Cursor="Hand" HorizontalAlignment="Stretch"
                                        BorderThickness="0">
                                    <Button.Background>
                                        <LinearGradientBrush StartPoint="0,0" EndPoint="1,0">
                                            <GradientStop Color="#059669" Offset="0"/>
                                            <GradientStop Color="#10B981" Offset="1"/>
                                        </LinearGradientBrush>
                                    </Button.Background>
                                    <Button.Resources>
                                        <Style TargetType="Border">
                                            <Setter Property="CornerRadius" Value="22"/>
                                        </Style>
                                    </Button.Resources>
                                </Button>
                                <Border x:Name="DetailNotInstalledBadge" Background="#161824" CornerRadius="22"
                                        Padding="14,12" Visibility="Collapsed" BorderBrush="#232636" BorderThickness="1">
                                    <TextBlock Text="📦  Não instalado" FontSize="13" FontWeight="SemiBold" Foreground="#9CA3AF"
                                               HorizontalAlignment="Center"/>
                                </Border>
 
                                <Button x:Name="DetailFavoriteButton" Grid.Column="1" Content="&#x2606;  Favoritar"
                                        Click="DetailFavoriteButton_Click"
                                        Style="{StaticResource TopChipStyle}" Background="#1F2233"
                                        FontSize="13" Padding="18,12" Margin="10,0,0,0"/>
                                <Button x:Name="DetailHideButton" Grid.Column="2" Content="Ocultar"
                                        Click="DetailHideButton_Click"
                                        Style="{StaticResource TopChipStyle}" Background="#1F2233"
                                        FontSize="13" Padding="18,12" Margin="10,0,0,0"/>
                            </Grid>
 
                            <!-- Números -->
                            <Grid Margin="0,18,0,0">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="Auto"/>
                                </Grid.ColumnDefinitions>
 
                                <Border Background="#161824" CornerRadius="12" Padding="16,12" Margin="0,0,10,0"
                                        BorderBrush="#232636" BorderThickness="1">
                                    <StackPanel>
                                        <TextBlock Text="TEMPO JOGADO" FontSize="10" FontWeight="Bold" Foreground="#6B7280" Margin="0,0,0,6"/>
                                        <!-- Uma linha por plataforma, para não estourar a largura quando há horas em 2-3 lojas -->
                                        <StackPanel x:Name="DetailPlaytimePanel"/>
                                    </StackPanel>
                                </Border>
                                <Border Grid.Column="1" Background="#161824" CornerRadius="12" Padding="16,12" Margin="0,0,10,0"
                                        BorderBrush="#232636" BorderThickness="1">
                                    <StackPanel>
                                        <TextBlock Text="ÚLTIMA SESSÃO" FontSize="10" FontWeight="Bold" Foreground="#6B7280" Margin="0,0,0,6"/>
                                        <TextBlock x:Name="DetailLastPlayedText" Text="&#x2014;" FontSize="17" FontWeight="Bold" Foreground="#60A5FA"
                                                   TextWrapping="Wrap"/>
                                    </StackPanel>
                                </Border>
                                <Border x:Name="DetailScoreBorder" Grid.Column="2" Background="#161824" CornerRadius="12" Padding="16,12"
                                        BorderBrush="#232636" BorderThickness="1" Visibility="Collapsed">
                                    <StackPanel>
                                        <TextBlock Text="NOTA CR&#xCD;TICA" FontSize="10" FontWeight="Bold" Foreground="#6B7280" Margin="0,0,0,6"/>
                                        <TextBlock x:Name="DetailScoreText" Text="&#x2014;" FontSize="17" FontWeight="Bold" Foreground="#F59E0B"/>
                                    </StackPanel>
                                </Border>
                            </Grid>

                            <Border x:Name="DetailShotsCard" Visibility="Collapsed"
                                    Background="#161824" CornerRadius="12" Padding="18,16" Margin="0,14,0,0"
                                    BorderBrush="#232636" BorderThickness="1">
                                <StackPanel>
                                    <TextBlock Text="CAPTURAS DE TELA" FontSize="10" FontWeight="Bold" Foreground="#6B7280" Margin="0,0,0,10"/>
                                    <ScrollViewer HorizontalScrollBarVisibility="Auto" VerticalScrollBarVisibility="Disabled"
                                                  PreviewMouseWheel="ShotsScroll_Wheel">
                                        <StackPanel x:Name="DetailShotsPanel" Orientation="Horizontal" Margin="0,0,0,6"/>
                                    </ScrollViewer>
                                </StackPanel>
                            </Border>

                            <!-- Sobre o jogo + desenvolvedora e publisher -->
                            <Border Background="#161824" CornerRadius="12" Padding="18,16" Margin="0,14,0,0"
                                    BorderBrush="#232636" BorderThickness="1">
                                <StackPanel>
                                    <TextBlock Text="SOBRE O JOGO" FontSize="10" FontWeight="Bold" Foreground="#6B7280" Margin="0,0,0,10"/>
                                    <TextBlock x:Name="DetailSummaryText"
                                               Text="Nenhum resumo dispon&#xED;vel para este jogo."
                                               FontSize="13" Foreground="#C0C8D8" TextWrapping="Wrap" LineHeight="21"/>
 
                                    <Rectangle Height="1" Fill="#232636" Margin="0,16,0,14"/>
 
                                    <Grid>
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="*"/>
                                            <ColumnDefinition Width="*"/>
                                        </Grid.ColumnDefinitions>
                                        <StackPanel Grid.Column="0">
                                            <TextBlock Text="DESENVOLVEDOR" FontSize="10" FontWeight="Bold" Foreground="#6B7280" Margin="0,0,0,4"/>
                                            <TextBlock x:Name="DetailDevText" Text="&#x2014;" FontSize="13" FontWeight="SemiBold" Foreground="#D1D5DB" TextWrapping="Wrap"/>
                                        </StackPanel>
                                        <StackPanel Grid.Column="1">
                                            <TextBlock Text="PUBLISHER" FontSize="10" FontWeight="Bold" Foreground="#6B7280" Margin="0,0,0,4"/>
                                            <TextBlock x:Name="DetailPubText" Text="&#x2014;" FontSize="13" FontWeight="SemiBold" Foreground="#D1D5DB" TextWrapping="Wrap"/>
                                        </StackPanel>
                                    </Grid>
                                </StackPanel>
                            </Border>

                            <!-- Status do jogo -->
                            <Border Background="#161824" CornerRadius="12" Padding="18,16,18,16" Margin="0,14,0,0"
                                    BorderBrush="#232636" BorderThickness="1">
                                <StackPanel>
                                    <TextBlock Text="STATUS" FontSize="10" FontWeight="Bold" Foreground="#6B7280" Margin="0,0,0,10"/>
                                    <WrapPanel x:Name="DetailStatusPanel"/>
                                </StackPanel>
                            </Border>

                            <Border Background="#161824" CornerRadius="12" Padding="18,16" Margin="0,14,0,0"
                                    BorderBrush="#232636" BorderThickness="1">
                                <StackPanel>
                                    <TextBlock Text="COLEÇÕES" FontSize="10" FontWeight="Bold" Foreground="#6B7280" Margin="0,0,0,10"/>
                                    <TextBlock x:Name="DetailCollectionsText" Text="Nenhuma" FontSize="12.5" Foreground="#D1D5DB"
                                               TextWrapping="Wrap" Margin="0,0,0,12"/>
                                    <Button x:Name="DetailCollectionsButton" Content="Editar coleções"
                                            Click="DetailCollectionsButton_Click"
                                            Style="{StaticResource TopChipStyle}" Background="#1F2233"
                                            HorizontalAlignment="Left" FontSize="12" Padding="14,8"/>
                                </StackPanel>
                            </Border>

                            <Border Background="#161824"  x:Name="DetailLinksCard" CornerRadius="12" Padding="18,16,18,8" Margin="0,14,0,0"
                                    BorderBrush="#232636" BorderThickness="1">
                                <StackPanel>
                                    <TextBlock Text="LINKS" FontSize="10" FontWeight="Bold" Foreground="#6B7280" Margin="0,0,0,10"/>
                                    <WrapPanel x:Name="DetailLinksPanel"/>
                                </StackPanel>
                            </Border>

                            <Border x:Name="DetailReqCard" Visibility="Collapsed"
                                    Background="#161824" CornerRadius="12" Padding="18,16" Margin="0,14,0,0"
                                    BorderBrush="#232636" BorderThickness="1">
                                <StackPanel>
                                    <TextBlock Text="REQUISITOS E IDIOMAS" FontSize="10" FontWeight="Bold" Foreground="#6B7280" Margin="0,0,0,10"/>

                                    <StackPanel Orientation="Horizontal" Margin="0,0,0,12">
                                        <TextBlock Text="Português:" FontSize="12" Foreground="#9CA3AF" Margin="0,0,8,0"/>
                                        <TextBlock x:Name="DetailLangText" Text="—" FontSize="12" FontWeight="SemiBold" Foreground="#9CA3AF"/>
                                    </StackPanel>

                                    <Grid>
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="*"/>
                                            <ColumnDefinition Width="16"/>
                                            <ColumnDefinition Width="*"/>
                                        </Grid.ColumnDefinitions>
                                        <StackPanel Grid.Column="0">
                                            <TextBlock Text="Mínimos" FontSize="11" FontWeight="Bold" Foreground="#10B981" Margin="0,0,0,6"/>
                                            <TextBlock x:Name="DetailReqMinText" FontSize="11.5" Foreground="#D1D5DB"
                                                       TextWrapping="Wrap" LineHeight="18"/>
                                        </StackPanel>
                                        <StackPanel Grid.Column="2">
                                            <TextBlock Text="Recomendados" FontSize="11" FontWeight="Bold" Foreground="#10B981" Margin="0,0,0,6"/>
                                            <TextBlock x:Name="DetailReqRecText" FontSize="11.5" Foreground="#D1D5DB"
                                                       TextWrapping="Wrap" LineHeight="18"/>
                                        </StackPanel>
                                    </Grid>
                                </StackPanel>
                            </Border>

                            <!-- Personalizar: capa, fundo e arte do card -->
                            <Border Background="#161824" x:Name="DetailCustomizeCard" CornerRadius="12" Padding="18,14,18,6" Margin="0,14,0,0"
                                    BorderBrush="#232636" BorderThickness="1">
                                <StackPanel>
                                    <TextBlock Text="PERSONALIZAR" FontSize="10" FontWeight="Bold" Foreground="#6B7280" Margin="0,0,0,10"/>
                                    <WrapPanel>
                                        <Button x:Name="ChangeCoverButton" Content="Trocar capa"
                                                Click="ChangeCoverButton_Click"
                                                Style="{StaticResource TopChipStyle}" Background="#1F2233"
                                                FontSize="12" Padding="14,8" Margin="0,0,8,8"/>
                                        <Button Content="Trocar fundo" Click="ChangeBackgroundButton_Click"
                                                Style="{StaticResource TopChipStyle}" Background="#1F2233"
                                                FontSize="12" Padding="14,8" Margin="0,0,0,8"/>
                                        <Button Content="&#x2715;" ToolTip="Voltar ao fundo automático"
                                                Click="RemoveBackgroundButton_Click"
                                                Style="{StaticResource TopChipStyle}" Background="#1F2233" Foreground="#9CA3AF"
                                                FontSize="12" Padding="12,8" Margin="4,0,12,8"/>
                                        <Button x:Name="SetCardArtButton" Content="Usar como arte do card"
                                                Click="SetCardArtButton_Click"
                                                Style="{StaticResource TopChipStyle}" Background="#1F2233"
                                                FontSize="12" Padding="14,8" Margin="0,0,0,8"/>
                                        <Button x:Name="ClearCardArtButton" Content="&#x2715;" ToolTip="Voltar ao aleatório"
                                                Click="ClearCardArtButton_Click" Visibility="Collapsed"
                                                Style="{StaticResource TopChipStyle}" Background="#1F2233" Foreground="#9CA3AF"
                                                FontSize="12" Padding="12,8" Margin="4,0,0,8"/>
                                    </WrapPanel>
                                </StackPanel>
                            </Border>
                        </StackPanel>
                    </ScrollViewer>
                </Grid>
            </Border>
        </Grid>

                <!-- Possíveis duplicados -->
        <Grid x:Name="DuplicatesRoot" Visibility="Collapsed" Panel.ZIndex="55">
            <Rectangle Fill="#000000" Opacity="0.6" MouseLeftButtonDown="DuplicatesOverlay_Click"/>
            <Border Width="720" MaxHeight="640" VerticalAlignment="Center" HorizontalAlignment="Center"
                    Background="#0D0F1B" BorderBrush="#232636" BorderThickness="1" CornerRadius="16" Padding="24,20">
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="*"/>
                    </Grid.RowDefinitions>
                    <DockPanel>
                        <Button DockPanel.Dock="Right" Content="&#x2715;" Click="DuplicatesClose_Click"
                                Style="{StaticResource TopChipStyle}" Background="#1F2233" Foreground="#9CA3AF"
                                Padding="12,6" Margin="0"/>
                        <TextBlock Text="POSS&#xCD;VEIS DUPLICADOS" FontSize="16" FontWeight="Bold" Foreground="#10B981"
                                   VerticalAlignment="Center"/>
                    </DockPanel>
                    <TextBlock Grid.Row="1" x:Name="DuplicatesHint" FontSize="12" Foreground="#9CA3AF"
                               TextWrapping="Wrap" Margin="0,8,0,14"/>
                    <ScrollViewer Grid.Row="2" VerticalScrollBarVisibility="Auto" FocusVisualStyle="{x:Null}">
                        <StackPanel x:Name="DuplicatesList" Margin="0,0,10,0"/>
                    </ScrollViewer>
                </Grid>
            </Border>
        </Grid>

                <!-- Estatísticas -->
        <Grid x:Name="StatsRoot" Visibility="Collapsed" Panel.ZIndex="55">
            <Rectangle Fill="#000000" Opacity="0.6" MouseLeftButtonDown="StatsOverlay_Click"/>
            <Border Width="760" MaxHeight="680" VerticalAlignment="Center" HorizontalAlignment="Center"
                    Background="#0D0F1B" BorderBrush="#232636" BorderThickness="1" CornerRadius="16" Padding="24,20">
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="*"/>
                    </Grid.RowDefinitions>
                    <DockPanel>
                        <Button DockPanel.Dock="Right" Content="&#x2715;" Click="StatsClose_Click"
                                Style="{StaticResource TopChipStyle}" Background="#1F2233" Foreground="#9CA3AF"
                                Padding="12,6" Margin="0"/>
                        <TextBlock Text="ESTAT&#xCD;STICAS" FontSize="16" FontWeight="Bold" Foreground="#10B981"
                                   VerticalAlignment="Center"/>
                    </DockPanel>
                    <TextBlock Grid.Row="1" x:Name="StatsSummary" FontSize="13" Foreground="#9CA3AF"
                               TextWrapping="Wrap" Margin="0,8,0,14"/>
                    <ScrollViewer Grid.Row="2" VerticalScrollBarVisibility="Auto" FocusVisualStyle="{x:Null}">
                        <StackPanel Margin="0,0,10,0">
                            <TextBlock Text="MAIS JOGADOS" FontSize="10" FontWeight="Bold" Foreground="#6B7280" Margin="0,0,0,10"/>
                            <StackPanel x:Name="StatsTopList"/>
                            <TextBlock Text="HORAS POR LOJA" FontSize="10" FontWeight="Bold" Foreground="#6B7280" Margin="0,18,0,10"/>
                            <StackPanel x:Name="StatsStoresList"/>
                        </StackPanel>
                    </ScrollViewer>
                </Grid>
            </Border>
        </Grid>

        <!-- Teclado virtual (controle) -->
        <Grid x:Name="KbRoot" Visibility="Collapsed" Panel.ZIndex="59">
            <Rectangle Fill="#000000" Opacity="0.4" MouseLeftButtonDown="KbOverlay_Click"/>
            <Border Width="760" VerticalAlignment="Bottom" HorizontalAlignment="Center" Margin="0,0,0,90"
                    Background="#0D0F1B" BorderBrush="#232636" BorderThickness="1" CornerRadius="16" Padding="24,20">
                <StackPanel>
                    <TextBlock Text="PESQUISAR" x:Name="KbTitle" FontSize="16" FontWeight="Bold" Foreground="#10B981"/>
                    <Border Background="#161824" CornerRadius="12" Padding="16,12" Margin="0,12,0,16"
                            BorderBrush="#232636" BorderThickness="1">
                        <TextBlock x:Name="KbText" FontSize="20" FontWeight="SemiBold" TextTrimming="CharacterEllipsis"/>
                    </Border>
                    <StackPanel x:Name="KbKeys"/>
                </StackPanel>
            </Border>
        </Grid>

        <Grid x:Name="ShotViewerRoot" Visibility="Collapsed" Panel.ZIndex="60"
                          Background="#E6080A12" MouseLeftButtonDown="ShotViewerBg_Click">
                    
                        <Border HorizontalAlignment="Center" VerticalAlignment="Center"
                                Margin="110,70" MaxWidth="1500"
                                Background="#0D0F1A" BorderBrush="#232636" BorderThickness="1" CornerRadius="10">
                            <Image x:Name="ShotViewerImage" Stretch="Uniform" Margin="2"
                                   RenderOptions.BitmapScalingMode="HighQuality"
                                   MouseLeftButtonDown="ShotViewerImage_Click"/>
                        </Border>
                    
                        <Button Content="✕  Fechar" x:Name="ShotCloseButton" Style="{StaticResource TopChipStyle}" Click="ShotViewerClose_Click"
                                HorizontalAlignment="Right" VerticalAlignment="Top" Margin="0,20,24,0"
                                Background="#1F2233" Padding="14,8" FontSize="12"/>
                    
                        <Button Content="‹" Style="{StaticResource TopChipStyle}" Click="ShotPrev_Click"
                                HorizontalAlignment="Left" VerticalAlignment="Center" Margin="30,0,0,0"
                                Width="44" Height="44" Padding="0,0,0,3"
                                Background="#1F2233" FontSize="24"/>
                        <Button Content="›" Style="{StaticResource TopChipStyle}" Click="ShotNext_Click"
                                HorizontalAlignment="Right" VerticalAlignment="Center" Margin="0,0,30,0"
                                Width="44" Height="44" Padding="0,0,0,3"
                                Background="#1F2233" FontSize="24"/>
                    
                        <TextBlock x:Name="ShotViewerCounter" HorizontalAlignment="Center" VerticalAlignment="Bottom"
                                   Margin="0,0,0,28" FontSize="12" Foreground="#9CA3AF" IsHitTestVisible="False"/>
        </Grid>


        <Grid x:Name="CollectionPickerRoot" Visibility="Collapsed" Panel.ZIndex="58">
            <Rectangle Fill="#000000" Opacity="0.6" MouseLeftButtonDown="CollectionPicker_BgClick"/>
            <Border Width="420" MaxHeight="520" VerticalAlignment="Center" HorizontalAlignment="Center"
                    Background="#0D0F1B" BorderBrush="#232636" BorderThickness="1" CornerRadius="16" Padding="22,18">
                <StackPanel>
                    <TextBlock Text="COLEÇÕES" FontSize="12" FontWeight="Bold" Foreground="#10B981"/>
                    <TextBlock x:Name="CollectionPickerTitle" FontSize="16" FontWeight="Bold" Foreground="White"
                               Margin="0,6,0,14" TextTrimming="CharacterEllipsis"/>
                    <ScrollViewer MaxHeight="340" VerticalScrollBarVisibility="Auto" FocusVisualStyle="{x:Null}">
                        <StackPanel x:Name="CollectionPickerList"/>
                    </ScrollViewer>
                    <TextBlock x:Name="CollectionPickerEmpty" Visibility="Collapsed" TextWrapping="Wrap"
                               Text="Você ainda não criou nenhuma coleção. Crie uma com o botão direito em um card, usando o mouse."
                               FontSize="12" Foreground="#9CA3AF"/>
                </StackPanel>
            </Border>
        </Grid>


        <!-- ══════════════════════════════════════════════════════════
             PAINEL INLINE: ADICIONAR JOGO MODIFICADO
        ══════════════════════════════════════════════════════════ -->
        <Grid x:Name="AddCustomGamePanelRoot" Visibility="Collapsed" Panel.ZIndex="50">

            <Rectangle Fill="#000000" Opacity="0.55" MouseLeftButtonDown="CloseAddCustomGame_Click"/>

            <Border x:Name="AddCustomGamePanel"
                    Width="500" HorizontalAlignment="Center" VerticalAlignment="Center"
                    Background="#0D0F1B" BorderBrush="#1E2236" BorderThickness="1"
                    CornerRadius="16">
                <Border.Effect>
                    <DropShadowEffect Color="#000000" BlurRadius="40" ShadowDepth="0" Opacity="0.7"/>
                </Border.Effect>

                <Grid Margin="32,28,32,32">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="Auto"/>
                    </Grid.RowDefinitions>

                    <!-- Cabeçalho -->
                    <DockPanel Grid.Row="0" Margin="0,0,0,24">
                        <Button DockPanel.Dock="Right" Content="&#x2715;" Click="CloseAddCustomGame_Click"
                                Width="32" Height="32" Background="#1E2236" Foreground="#9CA3AF"
                                FontSize="13" FontWeight="Bold" BorderThickness="0" Cursor="Hand">
                            <Button.Resources>
                                <Style TargetType="Border">
                                    <Setter Property="CornerRadius" Value="16"/>
                                </Style>
                            </Button.Resources>
                        </Button>
                        <TextBlock Text="Adicionar jogo modificado" FontSize="18" FontWeight="Bold"
                                   Foreground="White" VerticalAlignment="Center"/>
                    </DockPanel>

                    <!-- Executável label -->
                    <TextBlock Grid.Row="1" Text="EXECUT&#xC1;VEL" FontSize="10" FontWeight="Bold"
                               Foreground="#6B7280" Margin="0,0,0,6"/>

                    <!-- Executável campo + botão -->
                    <Grid Grid.Row="2" Margin="0,0,0,20">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="Auto"/>
                        </Grid.ColumnDefinitions>
                        <Border Grid.Column="0" Background="#1A1C2E" CornerRadius="8"
                                BorderBrush="#2A2D3A" BorderThickness="1">
                            <TextBlock x:Name="AddGameExePath" Text="Nenhum arquivo selecionado"
                                       Foreground="#6B7280" FontSize="13" Padding="10,9"
                                       TextTrimming="CharacterEllipsis" VerticalAlignment="Center"/>
                        </Border>
                        <Button Grid.Column="1" Content="Procurar" Click="AddGameBrowse_Click"
                                Margin="8,0,0,0" Background="#1F2233" Foreground="White"
                                BorderThickness="0" Padding="14,9" Cursor="Hand" FontSize="13">
                            <Button.Resources>
                                <Style TargetType="Border"><Setter Property="CornerRadius" Value="8"/></Style>
                            </Button.Resources>
                        </Button>
                    </Grid>

                    <!-- Nome label -->
                    <TextBlock Grid.Row="3" Text="NOME DO JOGO" FontSize="10" FontWeight="Bold"
                               Foreground="#6B7280" Margin="0,0,0,6"/>

                    <!-- Nome campo -->
                    <Border Grid.Row="4" Background="#1A1C2E" CornerRadius="8"
                            BorderBrush="#2A2D3A" BorderThickness="1" Margin="0,0,0,20"
                            Padding="10,3">
                        <TextBox x:Name="AddGameNameBox"
                                 Background="Transparent" Foreground="White" FontSize="14"
                                 BorderThickness="0" Padding="0,6" Height="32"
                                 CaretBrush="White" SelectionBrush="#10B981"/>
                    </Border>

                    <!-- Botões &#x2014; Row 5, separado do campo de nome -->
                    <StackPanel Grid.Row="5" Orientation="Horizontal" HorizontalAlignment="Right">
                        <Button Content="Cancelar" Click="CloseAddCustomGame_Click"
                                Background="#1E2236" Foreground="#9CA3AF" BorderThickness="0"
                                Padding="16,9" Margin="0,0,8,0" Cursor="Hand" FontSize="13">
                            <Button.Resources>
                                <Style TargetType="Border"><Setter Property="CornerRadius" Value="8"/></Style>
                            </Button.Resources>
                        </Button>
                        <Button Content="Adicionar" Click="ConfirmAddCustomGame_Click"
                                Background="#10B981" Foreground="White" FontWeight="Bold"
                                BorderThickness="0" Padding="16,9" Cursor="Hand" FontSize="13">
                            <Button.Resources>
                                <Style TargetType="Border"><Setter Property="CornerRadius" Value="8"/></Style>
                            </Button.Resources>
                        </Button>
                    </StackPanel>
                </Grid>
            </Border>
        </Grid>

        <!-- Bloqueador de eventos de mouse no modo controle.
             Fica sobre tudo (ZIndex 200), transparente e invisível.
             Quando ativo, engole qualquer MouseMove/Enter/Leave antes que
             chegue nos cards &#x2014; elimina hover e piscar do cursor. -->
        <Grid x:Name="MouseBlocker"
              Panel.ZIndex="200"
              Background="Transparent"
              Visibility="Collapsed"
              IsHitTestVisible="True"
              Cursor="None"/>

        <!-- Barra de dicas dos botões do controle: só aparece no modo controle.
             Não recebe mouse (IsHitTestVisible=False) e fica acima do painel de detalhe. -->
        <Border x:Name="ControllerHintBar" Panel.ZIndex="60" VerticalAlignment="Bottom"
                Visibility="Collapsed" IsHitTestVisible="False" Padding="22,0,22,12">
            <Border.Background>
                <LinearGradientBrush StartPoint="0,0" EndPoint="0,1">
                    <GradientStop Color="#000A0B10" Offset="0"/>
                    <GradientStop Color="#F00A0B10" Offset="0.5"/>
                </LinearGradientBrush>
            </Border.Background>
            <StackPanel x:Name="ControllerHintPanel" Orientation="Horizontal"
                        HorizontalAlignment="Center" Margin="0,22,0,0"/>
        </Border>

    </Grid>
    </Grid>
    
            <!-- Camada "Iniciando jogo": fica dentro do GameHub, some quando outra janela toma o foco -->
            <Border x:Name="LaunchOverlay" Background="#0B0C10" MouseLeftButtonUp="LaunchOverlay_Click"
                    Panel.ZIndex="90" Visibility="Collapsed">
                <Grid>
                    <Image x:Name="LaunchBgImage" Stretch="UniformToFill" Opacity="0.30"/>
                    <Rectangle>
                        <Rectangle.Fill>
                            <RadialGradientBrush>
                                <GradientStop Color="#000B0C10" Offset="0.2"/>
                                <GradientStop Color="#F00B0C10" Offset="1"/>
                            </RadialGradientBrush>
                        </Rectangle.Fill>
                    </Rectangle>
            
                    <StackPanel VerticalAlignment="Center" HorizontalAlignment="Center">
                        <Border Width="240" Height="340" CornerRadius="10" ClipToBounds="True"
                                Background="#141720">
                            <Border.Effect>
                                <DropShadowEffect Color="#10B981" BlurRadius="40"
                                                  ShadowDepth="0" Opacity="0.35"/>
                            </Border.Effect>
                            <Image x:Name="LaunchCoverImage" Stretch="UniformToFill"/>
                        </Border>
                        <TextBlock x:Name="LaunchTitleText" Foreground="White" FontSize="34"
                                   FontWeight="Bold" HorizontalAlignment="Center"
                                   Margin="0,28,0,6"/>
                        <TextBlock x:Name="LaunchStatusText" Foreground="#9CA3AF" FontSize="16"
                                   HorizontalAlignment="Center"/>
                        <ProgressBar x:Name="LaunchBar" Width="320" Height="4"
                                     IsIndeterminate="True" Margin="0,22,0,0"
                                     Foreground="#10B981" Background="#1F2937"
                                     BorderThickness="0"/>
                    </StackPanel>
                    <TextBlock Text="Clique ou ESC / B para fechar" Foreground="#4B5563" FontSize="12"
                    HorizontalAlignment="Center" VerticalAlignment="Bottom" Margin="0,0,0,24"/>
                </Grid>
            </Border>
    </Grid>
</Window>